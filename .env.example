# ===========================
# Parakh — Environment Variables
# ===========================
# Copy this file to .env and fill in your values

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=parakh
POSTGRES_PASSWORD=parakh_secret
POSTGRES_DB=parakh

# --- TimescaleDB ---
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_USER=parakh
TIMESCALE_PASSWORD=parakh_secret
TIMESCALE_DB=parakh_timeseries

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=parakh

# --- JWT ---
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# --- Finnhub ---
FINNHUB_API_KEY=your-finnhub-api-key

# --- Alpha Vantage (optional, Phase 2) ---
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# --- Email / SMTP (notification service) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Parakh <noreply@parakh.dev>

# --- Service Ports ---
USER_SERVICE_PORT=3001
MARKET_DATA_SERVICE_PORT=3002
INDICATOR_SERVICE_PORT=3003
SETUP_SERVICE_PORT=3004
ALERT_SERVICE_PORT=3005
BACKTEST_SERVICE_PORT=3006
FUNDAMENTALS_SERVICE_PORT=3007
NOTIFICATION_SERVICE_PORT=3008
WEBSOCKET_GATEWAY_PORT=3009
API_GATEWAY_PORT=3000

# --- Node Environment ---
NODE_ENV=development
