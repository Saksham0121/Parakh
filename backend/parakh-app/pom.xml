<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.parakh</groupId>
        <artifactId>parakh-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>parakh-app</artifactId>
    <packaging>jar</packaging>
    <name>parakh-app</name>
    <description>All-in-one deployment: parakh-core + parakh-engine in a single JVM, no Kafka required (for small hosts such as Render's free tier)</description>

    <dependencies>
        <dependency>
            <groupId>com.parakh</groupId>
            <artifactId>parakh-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.parakh</groupId>
            <artifactId>parakh-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>parakh-app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.parakh.app.ParakhApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
