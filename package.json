{
  "name": "parakh",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time trading analytics platform",
  "workspaces": [
    "common",
    "user-service",
    "market-data-service",
    "indicator-service",
    "setup-service",
    "alert-service",
    "backtest-service",
    "fundamentals-service",
    "notification-service",
    "websocket-gateway",
    "api-gateway",
    "frontend"
  ],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:backend": "./scripts/dev.sh --backend-only",
    "dev:all": "./scripts/dev.sh",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d postgres timescaledb redis kafka pgbouncer",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:setup": "DATABASE_URL=\"postgresql://parakh:parakh_secret@localhost:5434/parakh?schema=public\" npx prisma db push --schema=user-service/prisma/schema.prisma && DATABASE_URL=\"postgresql://parakh:parakh_secret@localhost:5434/parakh?schema=public\" node user-service/seed.js",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "docker:build": "docker compose -f infra/docker-compose.yml build"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
