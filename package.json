{
  "name": "parakh",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade real-time trading analytics, setups, and backtesting platform",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:backend": "./scripts/dev.sh --backend-only",
    "dev:frontend": "npm run dev -w frontend",
    "build:backend": "mvn -f backend clean package -DskipTests",
    "build:frontend": "npm run build -w frontend",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d postgres timescaledb redis kafka pgbouncer",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "docker:build": "docker compose -f infra/docker-compose.yml build"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
